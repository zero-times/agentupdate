{
  "productName": "AgentUpdate Validation",
  "identifier": "work.x5brain.agentupdate.validation",
  "build": {
    "beforeBuildCommand": "npm run build:validation-web"
  },
  "app": {
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "desktop-validation",
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-finish-cli-launch-validation",
            "allow-finish-desktop-validation",
            "allow-finish-workflow-validation",
            "allow-probe-panel",
            "allow-finish-panel-validation"
          ]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "AgentUpdate Validation",
        "width": 720,
        "height": 540,
        "minWidth": 720,
        "minHeight": 540,
        "resizable": true
      }
    ]
  }
}
