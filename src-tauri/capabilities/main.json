    "allow-cleanup-restore",
    "allow-reveal-export",
    "allow-check-app-release",
    "allow-check-desktop-apps",
    "allow-open-desktop-app-channel",
    "allow-open-app-release",
    "allow-get-cli-projects",
    "allow-save-cli-project",
    "allow-open-cli",
    "allow-install-cli",
    "allow-cli-install-history",
    "allow-rollback-cli-install",
    "allow-prepare-app-install",
