{
  "identifier": "main",
  "description": "The bundled main window may discover known Agent installations and query their official npm versions; no generic process or filesystem access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-app-overview",
    "allow-get-agent-support",
    "allow-discover-agents",
    "allow-list-agent-versions",
    "allow-select-agent-version",
    "allow-create-update-plan",
    "allow-get-plan-history",
    "allow-execute-update",
    "allow-execute-plan",
    "allow-cancel-plan",
    "allow-inspect-interrupted-tasks",
    "allow-export-transaction",
    "allow-reveal-export",
    "allow-check-app-release",
    "allow-check-desktop-apps",
    "allow-open-desktop-app-channel",
    "allow-open-app-release",
    "allow-get-cli-projects",
    "allow-save-cli-project",
    "allow-open-cli",
    "allow-install-cli",
    "allow-cli-install-history",
    "allow-prepare-app-install",
    "allow-install-app",
    "allow-app-install-history",
    "allow-finish-app-install",
    "allow-hide-main-window",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
