{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentUpdate Technical Spike",
  "version": "0.0.0",
  "identifier": "work.x5brain.agentupdate.spike",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "AgentUpdate 技术验证", "width": 740, "height": 520 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:",
      "capabilities": ["main-validation"]
    }
  },
  "bundle": {
    "active": true, "targets": ["app"], "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "15.0", "signingIdentity": "-" }
  }
}
